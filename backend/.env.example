# Required backend configuration
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=cgreen
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Contact-form email notifications via Zoho SMTP.
# SMTP_PASSWORD must be a Zoho *app-specific password*, not the account login
# password. Generate one at Zoho Mail > My Account > Security > App Passwords.
# Use smtp.zoho.in for an India-region account and smtp.zoho.com otherwise.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=info@cgreen.in
SMTP_PASSWORD=
# Zoho rejects a From address the authenticated user does not own; leave unset
# to send as SMTP_USER.
SENDER_EMAIL=info@cgreen.in
SENDER_NAME=CGreen Website
# Recipient(s). Comma-separate to notify more than one inbox.
NOTIFY_EMAIL=info@cgreen.in

# Optional alternative transport, used only when SMTP is unset or fails.
# RESEND_API_KEY=
