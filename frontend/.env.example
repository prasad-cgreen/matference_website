# Frontend build-time configuration (Create React App / CRACO).
# These values are compiled into the public browser bundle and must never
# contain a secret.

# Backend origin. Empty = same-origin API requests (the default deployment).
REACT_APP_BACKEND_URL=

# Cloudflare Turnstile site key for the contact form CAPTCHA.
# Pair it with TURNSTILE_SECRET_KEY in backend/.env. Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile
# Leave unset in local dev to hide the widget and skip the client-side gate.
REACT_APP_TURNSTILE_SITE_KEY=
